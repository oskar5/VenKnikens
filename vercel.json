{
  "version": 2,
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/js/products.js", "destination": "/api/index.js" },
    { "source": "/sitemap.xml", "destination": "/api/index.js" }
  ]
}
